# Copy to .env and fill in. Both are optional; without them digga runs slower / logs listens locally only.

# https://www.discogs.com/settings/developers → "Generate new token". 60 requests/min instead of 25.
DISCOGS_TOKEN=

# https://listenbrainz.org/settings/ → User token. Listens are submitted as they're logged.
LISTENBRAINZ_TOKEN=

# Overrides (defaults shown)
# DIGGA_DB=data/digga.db
# DIGGA_CATALOG=data/catalog.db
# DIGGA_URLS=http://localhost:5080
