<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarnOn>3390;FS3388;FS3559</WarnOn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Score.fs" />
    <Compile Include="Names.fs" />
    <Compile Include="Discogs.fs" />
    <Compile Include="Catalog.fs" />
    <Compile Include="Db.fs" />
    <Compile Include="Ranking.fs" />
    <Compile Include="ListenBrainz.fs" />
    <Compile Include="Scheduler.fs" />
    <Compile Include="Worker.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Giraffe" Version="8.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
